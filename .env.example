# Nach .env kopieren und lokal ausfüllen. Niemals echte Werte committen.
LLM_BASE_URL=https://inference.proxy.ti.bfh.ch/v1
# Persönlicher Key von access.mlmp.ti.bfh.ch/my-key, nie committen
LLM_API_KEY=sk-...
TUTOR_MODEL=qwen3.8-27b
GRADER_MODEL=gpt-oss:120b
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
# Stufe 0 (Incident-Hook) für den A/B-Test: incident | none
HOOK=none
