# Nach .env kopieren und lokal ausfüllen. Niemals echte Werte committen.
LLM_BASE_URL=https://inference.proxy.ti.bfh.ch/v1
# Persönlicher Key von access.mlmp.ti.bfh.ch/my-key, nie committen
LLM_API_KEY=sk-...
TUTOR_MODEL=qwen3.8-27b
GRADER_MODEL=gpt-oss:120b
# Tutor: Temperatur (0 bis 2) und Version von prompts/tutor_v<n>.md
TUTOR_TEMPERATURE=0.7
TUTOR_PROMPT_VERSION=1
# Strengere Anweisung für den 2. Versuch nach einem Guard-Treffer (prompts/tutor_strict_v<n>.md)
TUTOR_STRICT_VERSION=1
# Grader: tiefe Temperatur (0 bis 0.2 empfohlen) und Version von prompts/grader_v<n>.md
GRADER_TEMPERATURE=0.0
GRADER_PROMPT_VERSION=2
# Cache des Proxys umgehen (true für Evaluation und Pilot, sonst sind Läufe nicht unabhängig)
LLM_NO_CACHE=true
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
# Stufe 0 (Incident-Hook) für den A/B-Test: incident | none
HOOK=none
